      "$defs": {
        "ModuleSettingKind": {
          "description": "A `[[settings]]` kind: plugin.toml's three, plus `file` (spec v1.4, `hub = \"1.1\"`).",
          "oneOf": [
            {
              "enum": [
                "bool",
                "int",
                "text"
              ],
              "type": "string"
            },
            {
              "const": "file",
              "description": "A path the user picks with the hub's Choose file button (a native picker); the value is\nthe path as a string, `\"\"` for none.",
              "type": "string"
            }
          ]
        }
      },
      "additionalProperties": false,
      "description": "`[[settings]]`: as plugin.toml, plus `when`, and (spec v1.4) `kind = \"file\"` with `filter`.",
      "properties": {
        "default": {
          "description": "The value until the user changes it; its type must match `kind` (a string for `file`)."
        },
        "filter": {
          "description": "For `file` only: the file names the picker offers, as `*`/`?` patterns joined by `;`\n(`ExampleSDK*.dll`). No path separators (spec v1.4).",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/ModuleSettingKind"
