{
  "hub": "1.2",
  "icons": [
    "module",
    "battery",
    "bell",
    "bluetooth",
    "book",
    "brush",
    "calendar",
    "camera",
    "chart",
    "chat",
    "cloud",
    "folder",
    "gamepad",
    "gear",
    "headphones",
    "image",
    "info",
    "key",
    "keyboard",
    "lights",
    "link",
    "lock",
    "mic",
    "music",
    "palette",
    "play",
    "screen",
    "sparkle",
    "speaker",
    "terminal",
    "timer",
    "video",
    "wifi"
  ],
  "limits": {
    "canvas_shapes": 1000,
    "depth": 32,
    "frame_bytes": 4194304,
    "frames_per_s": 60,
    "message_nesting": 128,
    "nodes": 2000,
    "streams": 8,
    "table_rows": 10000,
    "text_bytes": 16384
  },
  "scalings": [
    "smooth",
    "pixel"
  ],
  "spec": "1.10",
  "streams": {
    "nodes": [
      "canvas",
      "image",
      "text",
      "markdown"
    ],
    "reopen_s": [
      1,
      2,
      4
    ],
    "text_bytes": 1048576
  },
  "tile_limits": {
    "buttons": 1,
    "depth": 3,
    "nodes": 12,
    "streams": 0,
    "text_bytes": 64
  },
  "tones": [
    "neutral",
    "active",
    "live",
    "ok",
    "attention",
    "off"
  ],
  "types": {
    "config.Config": {
      "$defs": {
        "Anchor": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "scope": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "id",
            "kind",
            "key",
            "scope"
          ],
          "type": "object"
        },
        "Source": {
          "additionalProperties": false,
          "properties": {
            "anchor": {
              "default": null,
              "description": "The anchor that signs it; none for a developer-mode folder.",
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/SourceKind"
            },
            "path": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "url": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "visibility": {
              "$ref": "#/$defs/Visibility"
            }
          },
          "required": [
            "id",
            "kind",
            "visibility"
          ],
          "type": "object"
        },
        "SourceKind": {
          "enum": [
            "catalog",
            "git",
            "folder"
          ],
          "type": "string"
        },
        "Trust": {
          "properties": {
            "anchors": {
              "default": [],
              "items": {
                "$ref": "#/$defs/Anchor"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "Visibility": {
          "enum": [
            "public",
            "private"
          ],
          "type": "string"
        }
      },
      "properties": {
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Source"
          },
          "type": "array"
        },
        "trust": {
          "$ref": "#/$defs/Trust",
          "default": {
            "anchors": []
          }
        }
      },
      "title": "Config",
      "type": "object"
    },
    "config.Windows": {
      "$defs": {
        "PageWindow": {
          "additionalProperties": false,
          "description": "What the hub keeps for one page (`[windows.\"<module id>/<panel id>\"]`, spec v1.6).",
          "properties": {
            "keep_on_top": {
              "default": false,
              "type": "boolean"
            },
            "places": {
              "default": [],
              "description": "At most [`PLACES_PER_PAGE`], one per layout.",
              "items": {
                "$ref": "#/$defs/Place"
              },
              "type": "array"
            },
            "popped_out": {
              "default": false,
              "description": "Open in its own window (restored as a pop-out, §2.5).",
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "Place": {
          "additionalProperties": false,
          "description": "One saved place of a pop-out: where it was in one screen layout (§2.5, spec v1.6).",
          "properties": {
            "height": {
              "format": "double",
              "type": "number"
            },
            "layout": {
              "description": "The screen layout's id: 16 lowercase hex digits (§2.5).",
              "type": "string"
            },
            "saved": {
              "description": "When it was saved, `YYYY-MM-DDTHH:MM:SSZ` (UTC); the oldest goes first.",
              "type": "string"
            },
            "screen": {
              "description": "The screen the window was on, by its display target path (§2.5).",
              "type": "string"
            },
            "state": {
              "$ref": "#/$defs/WindowState"
            },
            "width": {
              "description": "Size in device-independent units, above 0.",
              "format": "double",
              "type": "number"
            },
            "x": {
              "description": "Position from that screen's top-left, in device-independent units.",
              "format": "double",
              "type": "number"
            },
            "y": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "layout",
            "screen",
            "x",
            "y",
            "width",
            "height",
            "state",
            "saved"
          ],
          "type": "object"
        },
        "WindowState": {
          "description": "A pop-out's window state when it was saved (§2.5, spec v1.6).",
          "oneOf": [
            {
              "enum": [
                "normal",
                "maximized"
              ],
              "type": "string"
            },
            {
              "const": "snapped",
              "description": "Snapped by Windows; the place is the snapped rectangle.",
              "type": "string"
            }
          ]
        }
      },
      "description": "`hideout.toml`'s `[windows]` table (§2.5, §7.3, spec v1.6): keys are `<module id>/<panel id>`.",
      "properties": {
        "windows": {
          "additionalProperties": {
            "$ref": "#/$defs/PageWindow"
          },
          "default": {},
          "type": "object"
        }
      },
      "title": "Windows",
      "type": "object"
    },
    "legacy.Manifest": {
      "$defs": {
        "ActionDecl": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "description": "Stable: bindings and `action.invoked` use it (`toggle-mute`).",
              "type": "string"
            },
            "name": {
              "description": "For the Plugins tab (`Toggle mic mute`).",
              "type": "string"
            }
          },
          "required": [
            "id",
            "name"
          ],
          "type": "object"
        },
        "Permission": {
          "type": "string"
        },
        "Provides": {
          "enum": [
            "facts",
            "panel-layout",
            "lighting-effect",
            "action",
            "backend"
          ],
          "type": "string"
        },
        "SecretDecl": {
          "additionalProperties": false,
          "properties": {
            "label": {
              "description": "For the Plugins tab (`OBS WebSocket password`).",
              "type": "string"
            },
            "name": {
              "description": "What `secrets.get` asks for (`obs-password`).",
              "type": "string"
            }
          },
          "required": [
            "name",
            "label"
          ],
          "type": "object"
        },
        "SettingDecl": {
          "additionalProperties": false,
          "properties": {
            "default": {
              "description": "The value until the user changes it; its type must match `kind`."
            },
            "kind": {
              "$ref": "#/$defs/SettingKind"
            },
            "label": {
              "description": "For the Plugins tab (`Focus minutes`).",
              "type": "string"
            },
            "max": {
              "default": null,
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "min": {
              "default": null,
              "description": "For `int`: the range the Plugins tab allows.",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "name": {
              "description": "What the plugin reads (`focus-minutes`).",
              "type": "string"
            }
          },
          "required": [
            "name",
            "label",
            "kind",
            "default"
          ],
          "type": "object"
        },
        "SettingKind": {
          "enum": [
            "bool",
            "int",
            "text"
          ],
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "actions": {
          "default": [],
          "description": "Things a key can trigger (#212); the user binds them to keys in the Plugins tab.",
          "items": {
            "$ref": "#/$defs/ActionDecl"
          },
          "type": "array"
        },
        "api": {
          "description": "The API version it was built for (`major.minor`).",
          "type": "string"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "id": {
          "description": "Reverse-DNS, unique: also the plugin's folder name.",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "permissions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Permission"
          },
          "type": "array"
        },
        "provides": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Provides"
          },
          "type": "array"
        },
        "run": {
          "description": "The program and its arguments, relative to the plugin's folder.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "secrets": {
          "default": [],
          "description": "Secrets the user enters in the Plugins tab (#213); the plugin reads them with\n`secrets.get`. Needs the `secrets` permission.",
          "items": {
            "$ref": "#/$defs/SecretDecl"
          },
          "type": "array"
        },
        "settings": {
          "default": [],
          "description": "Options the user sets in the Plugins tab (#69, API 1.3); the plugin reads them with\n`settings.get` and hears of changes as `settings.changed`.",
          "items": {
            "$ref": "#/$defs/SettingDecl"
          },
          "type": "array"
        },
        "version": {
          "description": "The plugin's own semver.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "api",
        "run"
      ],
      "title": "Manifest",
      "type": "object"
    },
    "messages.ActionInvoke": {
      "$defs": {
        "ActionSource": {
          "enum": [
            "key",
            "tray",
            "palette",
            "panel"
          ],
          "type": "string"
        }
      },
      "description": "`action.invoke` (H → M).",
      "properties": {
        "action": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ActionSource"
        }
      },
      "required": [
        "action",
        "source"
      ],
      "title": "ActionInvoke",
      "type": "object"
    },
    "messages.ChannelCreate": {
      "description": "`channel.create` (H → M): the provider makes the pipe for `consumer`.",
      "properties": {
        "channel": {
          "type": "string"
        },
        "consumer": {
          "type": "string"
        },
        "consumer_pid": {
          "description": "(v1.10, #1092) The consumer's process id, when the hub knows it: the provider admits\nonly that process (`GetNamedPipeClientProcessId`) before it reads the nonce.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "consumer_sid": {
          "description": "(v1.10, #1092) The consumer's AppContainer SID, when it runs in one (§7.7): the pipe\nlets that SID in with client rights and carries a Low label, and nothing else changes.",
          "type": [
            "string",
            "null"
          ]
        },
        "nonce": {
          "type": "string"
        }
      },
      "required": [
        "channel",
        "consumer",
        "nonce"
      ],
      "title": "ChannelCreate",
      "type": "object"
    },
    "messages.ChannelOpen": {
      "description": "`channel.open` (C → H): the channel handshake's first half.",
      "properties": {
        "channel": {
          "type": "string"
        },
        "module": {
          "type": "string"
        }
      },
      "required": [
        "module",
        "channel"
      ],
      "title": "ChannelOpen",
      "type": "object"
    },
    "messages.ChannelOpened": {
      "description": "The `channel.open` result: the pipe to connect to and the nonce to present.",
      "properties": {
        "nonce": {
          "type": "string"
        },
        "pid": {
          "description": "(v1.10, #1092) The provider's process id, when the hub knows it: the consumer checks\nthat the pipe's server is that process (`GetNamedPipeServerProcessId`) before it sends\nthe nonce, as a module checks `HIDEOUT_HUB_PID` (§7.5).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "pipe": {
          "type": "string"
        }
      },
      "required": [
        "pipe",
        "nonce"
      ],
      "title": "ChannelOpened",
      "type": "object"
    },
    "messages.DrainResult": {
      "description": "The `module.drain` result.",
      "oneOf": [
        {
          "properties": {
            "state": {
              "const": "done",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "reason": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "state": {
              "const": "busy",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ],
      "title": "DrainResult"
    },
    "messages.HubNotify": {
      "$defs": {
        "NotifyLevel": {
          "enum": [
            "info",
            "warn",
            "error"
          ],
          "type": "string"
        }
      },
      "description": "`hub.notify` (M → H).",
      "properties": {
        "body": {
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/NotifyLevel"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "body",
        "level"
      ],
      "title": "HubNotify",
      "type": "object"
    },
    "messages.InitializeModule": {
      "description": "`initialize` from a module (M → H).",
      "properties": {
        "api": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "hub": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "instance",
        "token",
        "hub"
      ],
      "title": "InitializeModule",
      "type": "object"
    },
    "messages.InitializeTool": {
      "$defs": {
        "ClientInfo": {
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "version"
          ],
          "type": "object"
        }
      },
      "description": "`initialize` from an outside tool (T → H).",
      "properties": {
        "api": true,
        "client": {
          "$ref": "#/$defs/ClientInfo"
        },
        "hub": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "permissions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "client",
        "api"
      ],
      "title": "InitializeTool",
      "type": "object"
    },
    "messages.ModuleDrain": {
      "$defs": {
        "DrainReason": {
          "enum": [
            "update",
            "rollback",
            "reload",
            "disable",
            "remove"
          ],
          "type": "string"
        }
      },
      "description": "`module.drain` (H → M).",
      "properties": {
        "reason": {
          "$ref": "#/$defs/DrainReason"
        }
      },
      "required": [
        "reason"
      ],
      "title": "ModuleDrain",
      "type": "object"
    },
    "messages.ModuleIdParams": {
      "description": "`modules.enable`, `modules.disable`, `modules.reload`.",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "ModuleIdParams",
      "type": "object"
    },
    "messages.ModuleReady": {
      "description": "`module.ready` (M → H, notification).",
      "properties": {
        "instance": {
          "type": "string"
        }
      },
      "required": [
        "instance"
      ],
      "title": "ModuleReady",
      "type": "object"
    },
    "messages.ModuleRegister": {
      "description": "`module.register` (M → H).",
      "properties": {
        "apis": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "channels": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "facts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "methods": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "ModuleRegister",
      "type": "object"
    },
    "messages.Recovery": {
      "description": "The fact `module.<id>.recovery` (§7.8, spec v1.4): the step of the recovery ladder a\n`crash-stopped` module's card offers (its one main button).",
      "oneOf": [
        {
          "const": "start-again",
          "description": "**Start again** (the first stop this sign-in).",
          "type": "string"
        },
        {
          "const": "defaults",
          "description": "**Start with default settings** (the second stop).",
          "type": "string"
        },
        {
          "const": "go-back",
          "description": "**Go back to <previous>** (the third stop and later, when a previous version is kept).",
          "type": "string"
        },
        {
          "const": "last",
          "description": "**Copy diagnostics** and **Turn off <Module>** (the third stop and later, with no\nprevious version; #983).",
          "type": "string"
        }
      ],
      "title": "Recovery"
    },
    "messages.RegisterResult": {
      "$defs": {
        "RejectedItem": {
          "description": "One refused item in a `module.register` result.",
          "properties": {
            "error": {
              "type": "string"
            },
            "item": {
              "type": "string"
            }
          },
          "required": [
            "item",
            "error"
          ],
          "type": "object"
        }
      },
      "properties": {
        "rejected": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RejectedItem"
          },
          "type": "array"
        }
      },
      "title": "RegisterResult",
      "type": "object"
    },
    "messages.RestartFact": {
      "additionalProperties": false,
      "description": "The fact `module.<id>.restart` (§7.8, spec v1.4): set by the supervisor while the module waits\nto be restarted, `null` once the restart starts. `crash` is this crash's number in the\nten-minute window, 1 to `of` - 1 (the `of`-th stops it instead).",
      "properties": {
        "crash": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "delay_s": {
          "description": "Seconds until the restart: one of the §7.7 backoff steps.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "of": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "delay_s",
        "crash",
        "of"
      ],
      "title": "RestartFact",
      "type": "object"
    },
    "messages.SettingsSet": {
      "description": "`settings.set` (H → M).",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": true
      },
      "required": [
        "name",
        "value"
      ],
      "title": "SettingsSet",
      "type": "object"
    },
    "messages.UiAssetPut": {
      "description": "`ui.asset.put` (M → H): base64 `data`, at most 256 KiB decoded.",
      "properties": {
        "data": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        },
        "mime": {
          "type": "string"
        }
      },
      "required": [
        "hash",
        "mime",
        "data"
      ],
      "title": "UiAssetPut",
      "type": "object"
    },
    "messages.UiBadge": {
      "$defs": {
        "Badge": {
          "description": "The badge a module sets on its page panel's tab (v1.3, §5.9).",
          "oneOf": [
            {
              "const": "none",
              "description": "No badge.",
              "type": "string"
            },
            {
              "const": "attention",
              "description": "Something new wants a look (a dot).",
              "type": "string"
            },
            {
              "const": "dirty",
              "description": "Unsaved work: closing the tab asks first (§2.5).",
              "type": "string"
            },
            {
              "const": "count",
              "description": "`count` new items, 1 or more (the hub shows \"99+\" above 99).",
              "type": "string"
            }
          ]
        }
      },
      "description": "`ui.badge` (M → H, notification, v1.3). `count` is set with `badge: \"count\"` only.",
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "panel": {
          "type": "string"
        }
      },
      "required": [
        "panel",
        "badge"
      ],
      "title": "UiBadge",
      "type": "object"
    },
    "messages.UiEvent": {
      "description": "`ui.event` (H → M).",
      "properties": {
        "kind": {
          "type": "string"
        },
        "node": {
          "type": "string"
        },
        "panel": {
          "type": "string"
        },
        "value": {
          "default": null
        }
      },
      "required": [
        "panel",
        "node",
