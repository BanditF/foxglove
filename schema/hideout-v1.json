    "messages.UiVisibility": {
      "$defs": {
        "Visibility": {
          "oneOf": [
            {
              "const": "visible",
              "description": "On screen.",
              "type": "string"
            },
            {
              "const": "hidden",
              "description": "Still open but not on screen: a background tab, a minimised window, a tab of the hub's\nmain window while it is in the tray. A pop-out on screen stays visible (spec v1.6).",
              "type": "string"
            },
            {
              "const": "closed",
              "description": "The user closed the page (its tab, or Close page). Closing a pop-out docks it back\ninstead and is never `closed` (spec v1.6).",
              "type": "string"
