#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; }; // SYSTEM + M; the vendor Q+S+Z combo is gone (hit it while gaming)

/ {
    behaviors {
        // Step the right screen's art (#60): to the app while it's subscribed, else on the board.
        art_next: art_next {
            compatible = "foxglove,behavior-art-step";
            #binding-cells = <0>;
            display-name = "Next art";
        };
        art_prev: art_prev {
            compatible = "foxglove,behavior-art-step";
            #binding-cells = <0>;
            display-name = "Previous art";
            previous;
        };
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";

        // Backspace + Esc (right pinky column, top + bottom) toggles the Game layer
        game_toggle {
            bindings = <&tog 3>;
            key-positions = <12 41>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        function_from_typing { if-layers = <1 2>; then-layer = <5>; };
        function_from_game { if-layers = <4 2>; then-layer = <5>; };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R  &kp T                               &kp UP                &kp Y        &kp U  &kp I      &kp O    &kp P     &kp BSPC
&td0       &kp A  &kp S  &kp D     &kp F  &kp G                     &kp LEFT  &kp ENTER  &kp RIGHT  &kp H        &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL  &kp Z  &kp X  &kp C     &kp V  &kp B        &kp SPACE              &kp DOWN              &kp N        &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                         &kp LGUI  &mo 1  &kp SPACE                                                 &kp ENTER    &mo 2  &kp RALT
            >;

             sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        // NUMBER: hold the middle left thumb. Bluetooth keys moved to SYSTEM;
        // their old home-row positions are disabled.
        lower_layer {
            display-name = "NUMBER";
            bindings = <
&trans  &kp N1           &kp N2          &kp N3        &kp N4        &kp N5                                         &mmv MOVE_UP                     &kp N6           &kp N7           &kp N8           &kp N9           &kp N0    &kp BSPC
&trans  &none   &none    &none  &none  &none                   &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp LEFT         &kp DOWN         &kp UP           &kp RIGHT        &kp HOME  &kp PG_UP
&trans  &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &trans        &trans        &rgb_ug RGB_EFF  &kp C_MUTE                    &mmv MOVE_DOWN                   &rgb_ug RGB_EFR  &rgb_ug RGB_SPI  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &kp END   &kp PG_DN
                                         &trans        &mo 1         &trans                                                                          &kp INS          &mo 2            &kp DEL
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        // SYMBOL: hold the middle right thumb. Bluetooth clear and output keys
        // moved to SYSTEM; their old positions are disabled.
        raise_layer {
            display-name = "SYMBOL";
            bindings = <
&trans  &kp EXCL      &kp AT        &kp HASH   &kp DLLR   &kp PRCNT                            &mmv MOVE_UP                     &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&trans  &none    &mkp LCLK     &mkp MCLK  &mkp RCLK  &mkp MB4             &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&trans  &none  &none  &none      &none      &mkp MB5   &trans                    &mmv MOVE_DOWN                   &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                                    &trans     &mo 1      &kp SPACE                                                             &kp RET    &mo 2      &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        // Game layer (toggle: SYSTEM + G, or Backspace + Esc). Letters stay where they are;
        // only the thumbs and Shift change so nothing fires late or by accident. The right
        // outer thumb (right Alt on QWERTY) is the Windows key here, and Tab moves to GAME+
        // (Esc takes its place) so Shift below it can't catch it by accident.
        game_layer {
            display-name = "GAME";
            bindings = <
&kp ESC     &trans  &trans  &trans    &trans  &trans                            &trans                     &trans  &trans  &trans  &trans  &trans  &trans
&kp LSHIFT  &trans  &trans  &trans    &trans  &trans                    &trans  &trans  &trans             &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans  &trans  &trans    &trans  &trans  &trans                    &trans                     &trans  &trans  &trans  &trans  &trans  &trans
                            &kp LALT  &mo 4   &kp SPACE                                                    &kp ENTER  &mo 2   &kp LGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        // Hold the middle left thumb while in GAME: numbers where they'd sit on a
        // regular keyboard, plus Tab and the Y-P row you can't reach off the mouse.
        game_extras_layer {
            display-name = "GAME+";
            bindings = <
&kp TAB  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                            &trans                     &trans  &trans  &trans  &trans  &trans  &trans
&trans   &kp N6  &kp N7  &kp N8  &kp N9  &kp N0                    &trans  &trans  &trans             &trans  &trans  &trans  &trans  &trans  &trans
&trans   &kp Y   &kp U   &kp I   &kp O   &kp P   &trans                    &trans                     &trans  &trans  &trans  &trans  &trans  &trans
                         &trans  &mo 4   &trans                                                       &trans  &mo 2   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        // FUNCTION: hold BOTH middle thumbs (NUMBER + SYMBOL, or GAME+ + SYMBOL).
        // Function keys, Caps on A, Insert on Z, media and mouse controls stay safe.
        // Hold Tab as well for SYSTEM; all layer locks and power keys moved there.
        function_layer {
            display-name = "FUNCTION";
            bindings = <
&mo 6   &kp F1    &kp F2  &kp F3     &kp F4  &kp F5                          &mmv MOVE_UP                     &kp F6  &kp F7  &kp F8  &kp F9  &kp F10          &kp F11
&trans  &kp CAPS  &none   &mkp MCLK  &none   &none            &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &none   &mkp LCLK  &mkp MCLK  &mkp RCLK  &kp PRINTSCREEN  &kp F12
&trans  &kp INS   &trans  &none      &trans  &mkp MB5  &kp C_MUTE             &mmv MOVE_DOWN                   &none   &none   &none   &none   &kp SCROLLLOCK   &kp PAUSE_BREAK
                            &trans  &trans  &trans                                                       &trans  &trans  &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        // SYSTEM: keep FUNCTION held, then hold Tab. Tab stays transparent.
        // Q-T select Bluetooth 0-4; Y/U choose USB/BLE. Bottom far corners clear
        // the current/all Bluetooth profiles. A=QWERTY, S=SYMBOL, F=FUNCTION,
        // G=GAME, N=NUMBER. Tap a toggle again to turn it off.
        // Bootloader on C (left), comma and slash (right); reset on Z (left), dot (right).
        // M (hold 2 s) powers off both halves; the reset buttons wake them.
        // O / P step the right screen's art back / on (#60).
        system_layer {
            display-name = "SYSTEM";
            bindings = <
&trans          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4          &none         &out OUT_USB  &out OUT_BLE  &none        &art_prev   &art_next  &none
&none           &to 0         &tog 2        &none         &tog 5        &tog 3         &none  &none  &none  &none         &none         &none        &none       &none  &none
&bt BT_CLR      &sys_reset    &none         &bootloader   &none         &none   &none          &none         &tog 1        &soft_off     &bootloader  &sys_reset  &bootloader  &bt BT_CLR_ALL
                                            &none         &trans        &none                             &none         &trans        &none
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        // Spare layers for ZMK Studio's "Add layer" (#580): Studio can only enable layers the
        // keymap reserves. They come after SYSTEM so indexes 0-6 never move; a regular
        // (non-Studio) build, like the right half's, leaves them out.
        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};
