            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "ActivateProfileParams",
        "type": "object"
      },
      "permission": "profiles.write",
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Foxglove's profiles and the active one (`None` = the base settings).",
        "properties": {
          "active": {
            "type": [
              "string",
              "null"
            ]
          },
          "names": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "names"
        ],
        "title": "Profiles",
        "type": "object"
      }
    },
    "profiles.list": {
      "kind": "call",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Empty",
        "type": "object"
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Foxglove's profiles and the active one (`None` = the base settings).",
        "properties": {
          "active": {
            "type": [
              "string",
              "null"
            ]
          },
          "names": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "names"
        ],
        "title": "Profiles",
        "type": "object"
      }
