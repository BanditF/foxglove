    "screens.panel_override": {
      "kind": "call",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Draws over the left panel until `ttl_ms` passes (at most 60 000), then the panel goes back\nto what Foxglove draws. `ttl_ms` 0 holds it until the plugin replaces it, releases it\n(`screens.panel_release`) or its connection closes (API 1.3), so a steady screen needs no\nre-sending (#281). A later override replaces an earlier one.",
        "properties": {
          "bitmap": {
            "description": "1 bit per pixel, rows MSB first, padded to whole bytes, 1 = ink; base64.",
            "type": "string"
          },
          "device": {
            "type": "string"
          },
          "height": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "ttl_ms": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "width": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "device",
          "width",
          "height",
          "bitmap",
          "ttl_ms"
        ],
        "title": "PanelOverrideParams",
        "type": "object"
      },
      "permission": "screens.write",
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Empty",
        "type": "object"
      }
    },
    "screens.panel_release": {
      "kind": "call",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "device": {
            "type": "string"
          }
        },
        "required": [
          "device"
        ],
        "title": "DeviceParams",
        "type": "object"
      },
      "permission": "screens.write",
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Empty",
        "type": "object"
      }
    },
    "secrets.get": {
      "kind": "call",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "One of the plugin's own secrets (#213, API 1.2).",
        "properties": {
          "name": {
            "description": "1-64 of a-z, 0-9, - _ .",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "SecretName",
        "type": "object"
      },
      "permission": "secrets",
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "value": {
            "description": "`null` when it isn't set.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "SecretValue",
        "type": "object"
      }
    },
    "secrets.set": {
      "kind": "call",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Saves a secret (`null` removes it); at most 2048 bytes.",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name"
        ],
        "title": "SetSecretParams",
        "type": "object"
      },
      "permission": "secrets",
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Empty",
        "type": "object"
      }
    }
  },
  "transport": "JSON-RPC 2.0, one message per line"
}
