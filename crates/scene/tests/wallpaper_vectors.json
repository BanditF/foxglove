{
 "format": "foxglove-scene-vectors",
 "version": 1,
 "about": "Shared test vectors for the scene clock and the scanline (foxglove crates/scene, #493; bandit-wallpapers shared/foxglove-sync.js, #494). Each case: a foxglove_scene payload, a moment, and the expected phase, band centre (mm from the room's start along the direction) and per-point level. Both sides must agree within 1e-3 mm and 1e-4.",
 "formula": [
  "scene_ms = now_unix_ms - e",
  "phase = (scene_ms mod p) / p, euclidean; 0 when p = 0",
  "span = room.w*|cos a| + room.h*|sin a|",
  "centre = phase*(span + w) - w/2",
  "here = clamp01((proj(at) - lo) / (hi - lo)) * span, proj(q) = q.x cos a + q.y sin a over the room's corners",
  "level = smoothstep falloff: x = clamp01(|here - centre| / (w/2)); 1 - x*x*(3 - 2x); w = 0 draws nothing off the exact centre"
 ],
