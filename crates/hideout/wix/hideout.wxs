<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- H5.6 (review/design-h5-rebrand.md): the Hideout installer. Its own product, its own
       UpgradeCode (a test pins it different from Foxglove's 40F2C6EE-...), per user, no UAC.
       Hideout only: no Foxglove file, no firmware, no art. Built by scripts/build-hideout-installer.ps1
       (candle + light, WiX 3.14). docs/packaging.md "Building the Hideout installer". -->
  <?ifndef HideoutExe?>
  <?define HideoutExe = "$(sys.SOURCEFILEDIR)..\..\..\target\release\hideout.exe" ?>
  <?endif?>
  <?ifndef Version?>
  <?define Version = "0.1.0" ?>
  <?endif?>
  <Product Id="*" Name="Hideout" Language="1033" Version="$(var.Version)"
           Manufacturer="BanditF" UpgradeCode="0A0A820B-B3AE-427A-91A7-E7FF56509254">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" InstallPrivileges="limited" Platform="x64" />
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Hideout is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- The hub's trust rules fail closed on a UNC folder, so do not install there. -->
    <Condition Message="Hideout can only be installed on a local drive.">
      <![CDATA[Installed OR NOT (LocalAppDataFolder >< "\\")]]>
    </Condition>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="UserPrograms" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="Hideout">
            <!-- Files in the profile take an HKCU key path (ICE38) and remove their folders on
                 uninstall (ICE64). The record is what H5.2's autostart requires: the hub exe
                 must sit in the folder "App" names. -->
            <Component Id="Application" Guid="8367F575-2952-46A6-A27C-E7D63E5BFC48" Win64="yes">
              <File Id="HideoutExe" Name="hideout.exe" Source="$(var.HideoutExe)" />
              <File Id="LicenseHideout" Name="LICENSE-hideout" Source="$(sys.SOURCEFILEDIR)LICENSE-hideout" />
              <RegistryValue Root="HKCU" Key="Software\Hideout\Installer" Name="App"
                             Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
              <RegistryValue Root="HKCU" Key="Software\Hideout\Installer" Name="Exe"
                             Type="string" Value="[INSTALLFOLDER]hideout.exe" />
              <RegistryValue Root="HKCU" Key="Software\Hideout\Installer" Name="Version"
                             Type="string" Value="$(var.Version)" />
              <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
              <RemoveFolder Id="RemoveUserPrograms" Directory="UserPrograms" On="uninstall" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Component Id="StartMenu" Guid="*" Win64="yes">
          <Shortcut Id="StartMenuShortcut" Name="Hideout"
                    Target="[INSTALLFOLDER]hideout.exe" WorkingDirectory="INSTALLFOLDER" />
          <RegistryValue Root="HKCU" Key="Software\Hideout\Installer" Name="Shortcut"
                         Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>

    <!-- "Start with Windows" stays OFF: this installer never writes Hideout.lnk, a Startup
         entry or a Run value (H5.2: only the user's own Turn on writes it). On uninstall (not a
         major upgrade) the hub removes a Hideout.lnk the user turned on, only if it starts this
         exe, as the user, before the exe goes. The hub's Home and settings folders stay. -->
    <Feature Id="App" Title="Hideout" Description="The Hideout hub and its Start menu entry."
             Level="1" Absent="disallow">
      <ComponentRef Id="Application" />
      <ComponentRef Id="StartMenu" />
    </Feature>
    <CustomAction Id="RemoveAutostart" FileKey="HideoutExe" ExeCommand="--autostart-remove"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RemoveAutostart" Before="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>

    <!-- FR6 (review/ux-plan-first-run.md, Q1): a one-page install and a finish page. There is no
         accept box (Hub/user choice, overriding the Q1 recommendation): the install page shows the
         license behind a "Read the license" button that opens it on its own page, and Install is
         never gated on it. The finish page has "Open Hideout now" ticked, which starts the hub as
         the user with no arguments (never the tray flag, nothing at sign-in), and the line that apps
         already on the PC stay as they are. After a removal (REMOVE="ALL") the page says
         "Hideout is removed" and shows neither the line nor the box. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open Hideout now" />
    <Property Id="WixShellExecTarget" Value="[#HideoutExe]" />
    <CustomAction Id="LaunchHideout" BinaryKey="WixCA" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />

    <UI Id="HideoutUI">
      <UIRef Id="WixUI_Common" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <DialogRef Id="CancelDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Dialog Id="HideoutInstallDlg" Width="370" Height="270" Title="Install Hideout">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="20" Transparent="yes" NoPrefix="yes">
          <Text>{\WixUI_Font_Title}Install Hideout</Text>
        </Control>
        <Control Id="Body" Type="Text" X="20" Y="50" Width="330" Height="45" Transparent="yes" NoPrefix="yes"
                 Text="Hideout runs your apps for keyboards, lights and more in one place. It installs for you only, in your user folder." />
        <Control Id="LicenseLine" Type="Text" X="20" Y="110" Width="200" Height="17" Transparent="yes" NoPrefix="yes"
                 Text="Free under the MIT license." />
        <Control Id="ReadLicense" Type="PushButton" X="20" Y="130" Width="100" Height="17" Text="Read the license">
          <Publish Event="NewDialog" Value="HideoutLicenseDlg">1</Publish>
        </Control>
        <Control Id="LicenseAccepted" Type="CheckBox" X="20" Y="160" Width="330" Height="18" CheckBoxValue="1"
                 Property="LicenseAccepted" Text="I accept the terms of the license" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Install" Type="PushButton" ElevationShield="no" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Install">
          <Publish Event="EndDialog" Value="Return">LicenseAccepted = "1"</Publish>
          <Condition Action="disable">NOT LicenseAccepted</Condition>
          <Condition Action="enable">LicenseAccepted</Condition>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>

      <Dialog Id="HideoutLicenseDlg" Width="370" Height="270" Title="Hideout license">
        <Control Id="License" Type="ScrollableText" X="20" Y="20" Width="330" Height="195" Sunken="yes" TabSkip="no">
          <Text SourceFile="$(sys.SOURCEFILEDIR)license.rtf" />
        </Control>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="Back">
          <Publish Event="NewDialog" Value="HideoutInstallDlg">1</Publish>
        </Control>
      </Dialog>

      <Dialog Id="ExitDialog" Width="370" Height="270" Title="Hideout">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="20" Transparent="yes" NoPrefix="yes">
          <Text>{\WixUI_Font_Title}Hideout is installed</Text>
          <Condition Action="hide">REMOVE~="ALL"</Condition>
        </Control>
        <Control Id="TitleRemoved" Type="Text" X="20" Y="15" Width="330" Height="20" Transparent="yes" NoPrefix="yes">
          <Text>{\WixUI_Font_Title}Hideout is removed</Text>
          <Condition Action="hide">NOT REMOVE~="ALL"</Condition>
        </Control>
        <Control Id="Description" Type="Text" X="20" Y="50" Width="330" Height="45" Transparent="yes" NoPrefix="yes"
                 Text="Apps you already have stay as they are. Hideout does not start when you sign in unless you turn that on.">
          <Condition Action="hide">REMOVE~="ALL"</Condition>
        </Control>
        <Control Id="OptionalCheckBox" Type="CheckBox" X="20" Y="120" Width="330" Height="18" CheckBoxValue="1"
                 Property="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Text="Open Hideout now">
          <!-- A re-run of the MSI (Installed) launches nothing, and a removal has nothing to open,
               so the box is not shown then. -->
          <Condition Action="hide">Installed OR REMOVE~="ALL"</Condition>
        </Control>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="Finish">
          <Publish Event="DoAction" Value="LaunchHideout">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed AND NOT REMOVE~="ALL"</Publish>
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
      </Dialog>

      <InstallUISequence>
        <Show Dialog="HideoutInstallDlg" Before="ProgressDlg">Installed="" AND NOT RESUME AND NOT Preselected</Show>
        <Show Dialog="ExitDialog" OnExit="success" />
      </InstallUISequence>
    </UI>
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)license.rtf" />
  </Product>
</Wix>
