pcstate: HELLO caps bit 26 PC_STATE 1
pcstate: start, on battery: LEDs on, state 0, flags keys active
pcstate: -- on battery, as before: idle 30 s after the last key
pcstate: -- a key
pcstate: 29 s after the key: LEDs on, state 0, flags keys active
pcstate: to the right: 10 01
pcstate: LEDs off
pcstate: to the right: RGB on 0 (the left's own 1)
pcstate: 32 s after the key: LEDs off, state 0, flags -
pcstate: -- plugged in, the app not running: lit 10 minutes after the last key (#609 decision 2)
pcstate: -- the cable goes in
pcstate: LEDs on
pcstate: to the right: 10 00
pcstate: to the right: RGB on 1 (the left's own 1)
pcstate: to the right: 10 01
pcstate: to the right: RGB on 0 (the left's own 1)
pcstate: 35 s after the cable, no key: LEDs on, state 0, flags held usb active
pcstate: 9 min 50 s after it: LEDs on, state 0, flags held usb active
pcstate: LEDs off
pcstate: 10 min 5 s after it: LEDs off, state 0, flags usb
pcstate: -- the app: the PC awake, with the wake (the app starting, or #604's back)
pcstate: -- bad requests first: a lease of 0, an unknown state; nothing changes
pcstate: PC sends D7 11 01 00 lease 0
pcstate: keyboard D7 91: status 5, event 0, state 0, flags usb, lease 0, reason 4
pcstate: PC sends D7 11 03 00 lease 0
pcstate: keyboard D7 91: status 5, event 0, state 0, flags usb, lease 0, reason 4
pcstate: PC sends D7 11 01 01 lease 600
pcstate: to the right: 10 00
pcstate: LEDs on
pcstate: to the right: RGB on 1 (the left's own 1)
pcstate: to the right: 11 01 lease 600
pcstate: keyboard D7 91: status 0, event 0, state 1, flags held usb keys active, lease 600, reason 0
pcstate: to the right: 10 01
pcstate: to the right: RGB on 0 (the left's own 1)
pcstate: PC awake, 35 s after the wake: no idle at 30 s: LEDs on, state 1, flags held usb active
pcstate: -- a minute before the lease ends the keyboard asks; the app, the PC awake, renews it
pcstate: keyboard D7 91: status 0, event 1, state 1, flags held usb active, lease 60, reason 0
pcstate: PC sends D7 11 01 00 lease 600
pcstate: to the right: 11 01 lease 600
pcstate: keyboard D7 91: status 0, event 0, state 1, flags held usb active, lease 600, reason 0
pcstate: renewed: LEDs on, state 1, flags held usb active
pcstate: -- away (the display goes off): idle at once
pcstate: PC sends D7 11 00 00 lease 0
pcstate: LEDs off
pcstate: to the right: 11 02 lease 0
pcstate: keyboard D7 91: status 0, event 0, state 2, flags usb, lease 0, reason 3
pcstate: away: LEDs off, state 2, flags usb
pcstate: -- back (the display on, or an unlock): awake at once (#604)
pcstate: PC sends D7 11 01 01 lease 600
pcstate: to the right: 10 00
pcstate: LEDs on
pcstate: to the right: RGB on 1 (the left's own 1)
pcstate: to the right: 11 01 lease 600
pcstate: keyboard D7 91: status 0, event 0, state 1, flags held usb keys active, lease 600, reason 0
pcstate: back: LEDs on, state 1, flags held usb keys active
pcstate: -- away 5 s after a key: idle at once all the same
pcstate: -- a key
pcstate: PC sends D7 11 00 00 lease 0
pcstate: to the right: 10 01
pcstate: LEDs off
pcstate: to the right: RGB on 0 (the left's own 1)
pcstate: to the right: 11 02 lease 0
pcstate: keyboard D7 91: status 0, event 0, state 2, flags usb, lease 0, reason 3
pcstate: away within ZMK's 30 s: LEDs off, state 2, flags usb
pcstate: -- a key ends away: lit again, the USB idle time's rules until the app says more
pcstate: -- a key
pcstate: to the right: 10 00
pcstate: LEDs on
pcstate: to the right: RGB on 1 (the left's own 1)
pcstate: a key after away: LEDs on, state 0, flags usb keys active
pcstate: -- the app closes mid-lease: no renewals; lit 10 minutes after the last key, then idle
pcstate: PC sends D7 11 01 00 lease 300
pcstate: to the right: 11 01 lease 300
pcstate: keyboard D7 91: status 0, event 0, state 1, flags held usb keys active, lease 300, reason 0
pcstate: to the right: 10 01
pcstate: to the right: RGB on 0 (the left's own 1)
pcstate: -- a key
pcstate: to the right: 10 00
pcstate: to the right: RGB on 1 (the left's own 1)
pcstate: to the right: 10 01
pcstate: to the right: RGB on 0 (the left's own 1)
pcstate: keyboard D7 91: status 0, event 1, state 1, flags held usb active, lease 60, reason 0
pcstate: keyboard D7 91: status 0, event 1, state 1, flags held usb active, lease 20, reason 0
pcstate: the lease lapsed, 4 min 10 s after the last key: LEDs on, state 0, flags held usb active
pcstate: 9 min 50 s after the last key: LEDs on, state 0, flags held usb active
pcstate: LEDs off
pcstate: 10 min 10 s after the last key: LEDs off, state 0, flags usb
pcstate: -- unplugged while the PC holds it: the hold ends at once
pcstate: PC sends D7 11 01 01 lease 600
pcstate: to the right: 10 00
pcstate: LEDs on
pcstate: to the right: RGB on 1 (the left's own 1)
pcstate: to the right: 11 01 lease 600
pcstate: keyboard D7 91: status 0, event 0, state 1, flags held usb keys active, lease 600, reason 0
pcstate: to the right: 10 01
pcstate: to the right: RGB on 0 (the left's own 1)
pcstate: held, 35 s after the wake: LEDs on, state 1, flags held usb active
pcstate: -- #651's hardware reading: with the user's underglow off, RGB_STATE says off while the hold runs; the shown idle flag and D7 91 tell the hold apart
pcstate: -- the user turns the underglow off
pcstate: LEDs off
pcstate: to the right: RGB on 0 (the left's own 0)
pcstate: keyboard D7 83: left on 0; shown lit 0, wanted 0, idle 0
pcstate: PC sends D7 11 FF 00 lease 0
pcstate: keyboard D7 91: status 0, event 0, state 1, flags held usb active, lease -, reason 0
pcstate: -- the user turns the underglow on
pcstate: LEDs on
pcstate: to the right: RGB on 0 (the left's own 1)
pcstate: keyboard D7 83: left on 1; shown lit 1, wanted 1, idle 0
pcstate: -- the cable comes out
pcstate: LEDs off
pcstate: unplugged: LEDs off, state 1, flags -
pcstate: -- as the right (#609 decision 3): the PC state from the left; the left's keys idle, the left's own on/off on; the right's own keys don't count while it follows the left
pcstate: the right on battery, the left held lit: LEDs off, state 1, flags -
pcstate: -- the cable goes in
pcstate: LEDs on
pcstate: the right on USB power: held, with the left's own on/off: LEDs on, state 1, flags held usb active
pcstate: LEDs off
pcstate: the left relays away: LEDs off, state 2, flags usb
pcstate: LEDs on
pcstate: the left relays awake: LEDs on, state 1, flags held usb active
pcstate: -- the cable comes out
pcstate: LEDs off
pcstate: the right unplugged: its battery rules again: LEDs off, state 1, flags -
pcstate: -- on battery: ZMK's own deep sleep 30 minutes after the last activity, unchanged
pcstate: 29 min 50 s after the last activity: LEDs off, state 0, flags -
pcstate: to the right: 10 02
SIM_SLEEP
