{
  "name": "lease-addressed-event",
  "module": "foxglove.example-art",
  "spec": [
    "8.5",
    "8.8"
  ],
  "description": "(v1.3) A provider event with params.to naming a lease goes only to that lease's holder; a second consumer gets nothing. An addressed event for a lease that has ended is dropped.",
  "steps": [
    {
      "from": "tool",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "example.art.lease",
        "params": {}
      }
    },
    {
      "from": "hub",
      "to": "module",
      "msg": {
        "jsonrpc": "2.0",
        "id": 50,
        "method": "example.art.lease",
        "params": {}
      }
    },
    {
      "from": "module",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 50,
        "result": {
          "lease": "L1"
        }
      }
    },
    {
      "from": "hub",
      "to": "tool",
      "msg": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "lease": "L1"
        }
      }
    },
    {
      "from": "module",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "method": "example.art.frame",
        "params": {
          "to": "L1",
          "n": 1
        }
      }
    },
    {
      "from": "hub",
      "to": "tool",
      "msg": {
        "jsonrpc": "2.0",
        "method": "example.art.frame",
        "params": {
          "to": "L1",
          "n": 1
        }
      }
    },
    {
      "from": "tool",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "example.art.release",
        "params": {
          "lease": "L1"
        }
      }
    },
    {
      "from": "hub",
      "to": "module",
      "msg": {
        "jsonrpc": "2.0",
        "id": 51,
        "method": "example.art.release",
        "params": {
          "lease": "L1"
        }
      }
    },
    {
      "from": "hub",
      "to": "module",
      "msg": {
        "jsonrpc": "2.0",
        "method": "lease.closed",
        "params": {
          "lease": "L1",
          "reason": "released"
        }
      }
    },
    {
      "from": "module",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 51,
        "result": {}
      }
    },
    {
      "from": "hub",
      "to": "tool",
      "msg": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {}
      }
    },
    {
      "from": "module",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "method": "example.art.frame",
        "params": {
          "to": "L1",
          "n": 2
        }
      }
    }
  ]
}
