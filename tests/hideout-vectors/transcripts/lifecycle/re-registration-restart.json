{
  "name": "re-registration-restart",
  "module": "foxglove.example-art",
  "spec": [
    "5.6",
    "7.5"
  ],
  "description": "A new instance after a crash restart registers again; the hub replaces the module's panels in one step and keeps view state by node id.",
  "steps": [
    {
      "event": "instance inst-1 crashed; panels greyed with state, not removed"
    },
    {
      "from": "module",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
          "id": "foxglove.example-art",
          "version": "0.4.0",
          "instance": "inst-2",
          "token": "tok-launch-2",
          "hub": "1.0",
          "api": {
            "foxglove": "1.13"
          }
        }
      }
    },
    {
      "from": "hub",
      "to": "module",
      "msg": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "hub": "1.1",
          "api": {
            "foxglove": "1.13"
          },
          "granted": [
            "facts.read:keyboard.*",
            "hub.notify",
            "provide:example.art.*",
            "channel.offer:previews"
          ],
          "settings_dir": "C:/example/settings/foxglove.example-art",
          "data_dir": "C:/example/data/foxglove.example-art",
          "safe_mode": false
        }
      }
    },
    {
      "from": "module",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "module.register",
        "params": {
          "methods": [
            "example.art.*"
          ],
          "facts": [],
          "channels": [],
          "apis": {
            "foxglove": "1.13"
          }
        }
      }
    },
    {
      "from": "hub",
      "to": "module",
      "msg": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "rejected": []
        }
      }
    },
    {
      "from": "module",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "ui.register",
        "params": {
          "instance": "inst-2",
          "panels": [
            {
              "id": "art",
              "slot": "page",
              "title": "Art",
              "icon": "image",
              "tree": {
                "type": "column",
                "id": "root",
                "props": {},
                "children": [
                  {
                    "type": "label",
                    "id": "title",
                    "props": {
                      "text": "Art"
                    }
                  },
                  {
                    "type": "button",
                    "id": "next",
                    "props": {
                      "label": "Next"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "from": "hub",
      "to": "module",
      "msg": {
        "jsonrpc": "2.0",
        "id": 3,
        "result": {
          "rejected": []
        }
      }
    },
    {
      "from": "module",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "method": "module.ready",
        "params": {
          "instance": "inst-2"
        }
      }
    }
  ]
}
