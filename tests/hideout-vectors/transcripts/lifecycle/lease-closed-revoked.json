{
  "name": "lease-closed-revoked",
  "module": "foxglove.example-art",
  "spec": [
    "8.5",
    "8.8",
    "12.4"
  ],
  "description": "(v1.6) A module holds a lease and an accepted catalog revokes its version: the hub ends the lease and tells the provider with lease.closed {lease, reason: revoked}, once; the module's later disconnect sends nothing more.",
  "steps": [
    {
      "from": "consumer",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "example.art.lease",
        "params": {}
      }
    },
    {
      "from": "hub",
      "to": "module",
      "msg": {
        "jsonrpc": "2.0",
        "id": 50,
        "method": "example.art.lease",
        "params": {}
      }
    },
    {
      "from": "module",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 50,
        "result": {
          "lease": "L1"
        }
      }
    },
    {
      "from": "hub",
      "to": "consumer",
      "msg": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "lease": "L1"
        }
      }
    },
    {
      "event": "an accepted catalog revokes the consumer's version 0.4.0, reason \"placeholder reason\""
    },
    {
      "from": "hub",
      "to": "module",
      "msg": {
        "jsonrpc": "2.0",
        "method": "lease.closed",
        "params": {
          "lease": "L1",
          "reason": "revoked"
        }
      }
    },
    {
      "event": "the consumer's connection ends"
    }
  ]
}
