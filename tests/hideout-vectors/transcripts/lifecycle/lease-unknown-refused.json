{
  "name": "lease-unknown-refused",
  "module": "foxglove.example-art",
  "spec": [
    "8.5",
    "15"
  ],
  "description": "(v1.14) Only a lease's holder may name it: a second consumer releasing the first one's lease, or naming an id nobody was handed, is refused with -32602 lease.unknown and nothing reaches the provider; the holder's own release still goes through.",
  "steps": [
    {
      "from": "tool",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "example.art.lease",
        "params": {}
      }
    },
    {
      "from": "hub",
      "to": "module",
      "msg": {
        "jsonrpc": "2.0",
        "id": 50,
        "method": "example.art.lease",
        "params": {}
      }
    },
    {
      "from": "module",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 50,
        "result": {
          "lease": "L1"
        }
      }
    },
    {
      "from": "hub",
      "to": "tool",
      "msg": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "lease": "L1"
        }
      }
    },
    {
      "from": "other",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 7,
        "method": "example.art.release",
        "params": {
          "lease": "L1"
        }
      }
    },
    {
      "from": "hub",
      "to": "other",
      "msg": {
        "jsonrpc": "2.0",
        "id": 7,
        "error": {
          "code": -32602,
          "message": "invalid params",
          "data": {
            "id": "lease.unknown"
          }
        }
      }
    },
    {
      "from": "other",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 8,
        "method": "example.art.update",
        "params": {
          "lease": "L2"
        }
      }
    },
    {
      "from": "hub",
      "to": "other",
      "msg": {
        "jsonrpc": "2.0",
        "id": 8,
        "error": {
          "code": -32602,
          "message": "invalid params",
          "data": {
            "id": "lease.unknown"
          }
        }
      }
    },
    {
      "from": "tool",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "example.art.release",
        "params": {
          "lease": "L1"
        }
      }
    },
    {
      "from": "hub",
      "to": "module",
      "msg": {
        "jsonrpc": "2.0",
        "id": 51,
        "method": "example.art.release",
        "params": {
          "lease": "L1"
        }
      }
    },
    {
      "from": "hub",
      "to": "module",
      "msg": {
        "jsonrpc": "2.0",
        "method": "lease.closed",
        "params": {
          "lease": "L1",
          "reason": "released"
        }
      }
    },
    {
      "from": "module",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 51,
        "result": {}
      }
    },
    {
      "from": "hub",
      "to": "tool",
      "msg": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {}
      }
    }
  ]
}
