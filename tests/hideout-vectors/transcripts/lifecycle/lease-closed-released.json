{
  "name": "lease-closed-released",
  "module": "foxglove.example-art",
  "spec": [
    "8.5",
    "8.8"
  ],
  "description": "(v1.3) A consumer gives its lease back: the hub forwards the release call, then tells the provider with lease.closed {lease, reason: released}.",
  "steps": [
    {
      "from": "tool",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "example.art.lease",
        "params": {}
      }
    },
    {
      "from": "hub",
      "to": "module",
      "msg": {
        "jsonrpc": "2.0",
        "id": 50,
        "method": "example.art.lease",
        "params": {}
      }
    },
    {
      "from": "module",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 50,
        "result": {
          "lease": "L1"
        }
      }
    },
    {
      "from": "hub",
      "to": "tool",
      "msg": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "lease": "L1"
        }
      }
    },
    {
      "from": "tool",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "example.art.release",
        "params": {
          "lease": "L1"
        }
      }
    },
    {
      "from": "hub",
      "to": "module",
      "msg": {
        "jsonrpc": "2.0",
        "id": 51,
        "method": "example.art.release",
        "params": {
          "lease": "L1"
        }
      }
    },
    {
      "from": "hub",
      "to": "module",
      "msg": {
        "jsonrpc": "2.0",
        "method": "lease.closed",
        "params": {
          "lease": "L1",
          "reason": "released"
        }
      }
    },
    {
      "from": "module",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 51,
        "result": {}
      }
    },
    {
      "from": "hub",
      "to": "tool",
      "msg": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {}
      }
    }
  ]
}
