{
  "name": "register-ready",
  "module": "foxglove.example-art",
  "spec": [
    "7.5",
    "6.3",
    "8.8"
  ],
  "description": "Registration: module.register (one method rejected because the catalog does not allow it), ui.register, module.ready. Only after ready does the router send traffic.",
  "steps": [
    {
      "from": "module",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
          "id": "foxglove.example-art",
          "version": "0.4.0",
          "instance": "inst-1",
          "token": "tok-launch-1",
          "hub": "1.0",
          "api": {
            "foxglove": "1.13"
          }
        }
      }
    },
    {
      "from": "hub",
      "to": "module",
      "msg": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "hub": "1.2",
          "api": {
            "foxglove": "1.13"
          },
          "granted": [
            "facts.read:keyboard.*",
            "hub.notify",
            "provide:example.art.*",
            "channel.offer:previews"
          ],
          "settings_dir": "C:/example/settings/foxglove.example-art",
          "data_dir": "C:/example/data/foxglove.example-art",
          "safe_mode": false
        }
      }
    },
    {
      "from": "module",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "module.register",
        "params": {
          "methods": [
            "example.art.*",
            "lighting.*"
          ],
          "facts": [
            "example.art.*"
          ],
          "channels": [
            "previews"
          ],
          "apis": {
            "foxglove": "1.13"
          }
        }
      }
    },
    {
      "from": "hub",
      "to": "module",
      "msg": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "rejected": [
            {
              "item": "lighting.*",
              "error": "permission.provider"
            }
          ]
        }
      },
      "why": "the catalog entry's provide is [example.art.*] only (6.3)"
    },
    {
      "from": "module",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "ui.register",
        "params": {
          "instance": "inst-1",
          "panels": [
            {
              "id": "art",
              "slot": "page",
              "title": "Art",
              "icon": "image",
              "tree": {
                "type": "column",
                "id": "root",
                "props": {},
                "children": [
                  {
                    "type": "label",
                    "id": "title",
                    "props": {
                      "text": "Art"
                    }
                  },
                  {
                    "type": "button",
                    "id": "next",
                    "props": {
                      "label": "Next"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "from": "hub",
      "to": "module",
      "msg": {
        "jsonrpc": "2.0",
        "id": 3,
        "result": {
          "rejected": []
        }
      }
    },
    {
      "from": "module",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "method": "module.ready",
        "params": {
          "instance": "inst-1"
        }
      }
    },
    {
      "event": "router now sends traffic; panels go live"
    }
  ]
}
