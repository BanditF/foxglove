{
  "name": "patch-event-asset",
  "module": "foxglove.example-art",
  "spec": [
    "5.3",
    "8.8"
  ],
  "description": "ui.patch (notification) set/insert/remove; ui.event refused with data.reason (hub reverts optimistic input); ui.asset.put by SHA-256.",
  "steps": [
    {
      "from": "module",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "method": "ui.patch",
        "params": {
          "panel": "art",
          "ops": [
            {
              "op": "set",
              "node": "title",
              "props": {
                "text": "Art (3)"
              }
            },
            {
              "op": "insert",
              "node": "root",
              "index": 2,
              "tree": {
                "type": "label",
                "id": "extra",
                "props": {
                  "text": "New"
                }
              }
            },
            {
              "op": "remove",
              "node": "extra"
            }
          ]
        }
      }
    },
    {
      "from": "hub",
      "to": "module",
      "msg": {
        "jsonrpc": "2.0",
        "id": 5,
        "method": "ui.event",
        "params": {
          "panel": "art",
          "node": "next",
          "kind": "click",
          "value": null
        }
      }
    },
    {
      "from": "module",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 5,
        "error": {
          "code": 5,
          "message": "refused",
          "data": {
            "reason": "No art pack is loaded"
          }
        }
      }
    },
    {
      "event": "hub reverts the optimistic change and shows 'No art pack is loaded'"
    },
    {
      "from": "hub",
      "to": "module",
      "msg": {
        "jsonrpc": "2.0",
        "id": 6,
        "method": "ui.event",
        "params": {
          "panel": "art",
          "node": "next",
          "kind": "click",
          "value": null
        }
      }
    },
    {
      "from": "module",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 6,
        "result": {}
      }
    },
    {
      "from": "module",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 7,
        "method": "ui.asset.put",
        "params": {
          "hash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "mime": "image/png",
          "data": "iVBORw0KGgo="
        }
      }
    },
    {
      "from": "hub",
      "to": "module",
      "msg": {
        "jsonrpc": "2.0",
        "id": 7,
        "result": {}
      }
    }
  ]
}
