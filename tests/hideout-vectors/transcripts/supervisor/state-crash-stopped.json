{
  "name": "state-crash-stopped",
  "module": "foxglove.example-art",
  "spec": [
    "7.8"
  ],
  "description": "State crash-stopped: the fact module.<id>.state is 'crash-stopped'.",
  "steps": [
    {
      "event": "trigger: fifth crash in ten minutes"
    },
    {
      "from": "hub",
      "to": "subscribers",
      "msg": {
        "jsonrpc": "2.0",
        "method": "facts.changed",
        "params": {
          "subscription": 1,
          "key": "module.foxglove.example-art.state",
          "value": "crash-stopped"
        }
      }
    },
    {
      "from": "hub",
      "to": "subscribers",
      "msg": {
        "jsonrpc": "2.0",
        "method": "facts.changed",
        "params": {
          "subscription": 1,
          "key": "module.foxglove.example-art.reason",
          "value": "It crashed 5 times in 10 minutes"
        }
      },
      "why": "reason text is plain words and free; only the state id is the contract"
    },
    {
      "expect": {
        "ui_name": "Stopped after 5 crashes",
        "ways_out": [
          "Start again",
          "Start with default settings",
          "Go back to <previous>",
          "Copy diagnostics"
        ],
        "shown_in": [
          "panel header",
          "Modules page",
          "tray status line"
        ]
      }
    }
  ]
}
