{
  "name": "rollback-after-update",
  "module": "foxglove.example-art",
  "spec": [
    "7.8"
  ],
  "description": "A module that reaches crash-stopped within 10 minutes of an update goes back to the previous version by itself and says so.",
  "steps": [
    {
      "event": "update 0.4.0 -> 0.5.0 completes at t=0"
    },
    {
      "event": "five crashes by t=400 s: crash-stopped"
    },
    {
      "event": "hub restores 0.4.0 (inventory 'previous') and starts it"
    },
    {
      "from": "hub",
      "to": "user",
      "msg": {
        "jsonrpc": "2.0",
        "method": "hub.notify",
        "params": {
          "title": "Example Art",
          "body": "Went back to 0.4.0 after 5 crashes",
          "level": "warn"
        }
      }
    },
    {
      "expect": {
        "final_version": "0.4.0",
        "said_so": true
      }
    }
  ]
}
