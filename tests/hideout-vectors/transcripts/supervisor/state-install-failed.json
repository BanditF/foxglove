{
  "name": "state-install-failed",
  "module": "foxglove.example-art",
  "spec": [
    "7.8"
  ],
  "description": "State install-failed: the fact module.<id>.state is 'install-failed'.",
  "steps": [
    {
      "event": "trigger: install or update step failed"
    },
    {
      "from": "hub",
      "to": "subscribers",
      "msg": {
        "jsonrpc": "2.0",
        "method": "facts.changed",
        "params": {
          "subscription": 1,
          "key": "module.foxglove.example-art.state",
          "value": "install-failed"
        }
      }
    },
    {
      "from": "hub",
      "to": "subscribers",
      "msg": {
        "jsonrpc": "2.0",
        "method": "facts.changed",
        "params": {
          "subscription": 1,
          "key": "module.foxglove.example-art.reason",
          "value": "The download did not match its signature"
        }
      },
      "why": "reason text is plain words and free; only the state id is the contract"
    },
    {
      "expect": {
        "ui_name": "Couldn't install / update",
        "ways_out": [
          "Try again",
          "Open log"
        ],
        "shown_in": [
          "panel header",
          "Modules page",
          "tray status line"
        ]
      }
    }
  ]
}
