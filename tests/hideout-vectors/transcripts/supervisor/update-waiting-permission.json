{
  "name": "update-waiting-permission",
  "module": "foxglove.example-art",
  "spec": [
    "6.4",
    "7.8"
  ],
  "description": "An update that adds permissions keeps the old version running and shows Update waiting for you; never a modal at sign-in.",
  "steps": [
    {
      "event": "catalog update: 0.5.0 adds key.events"
    },
    {
      "expect": {
        "running_version": "0.4.0",
        "state": "update-waiting",
        "modal_at_signin": false
      }
    },
    {
      "event": "user clicks Review and approves"
    },
    {
      "expect": {
        "state": "updating"
      }
    }
  ]
}
