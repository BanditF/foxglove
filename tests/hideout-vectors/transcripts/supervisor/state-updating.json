{
  "name": "state-updating",
  "module": "foxglove.example-art",
  "spec": [
    "7.8"
  ],
  "description": "State updating: the fact module.<id>.state is 'updating'.",
  "steps": [
    {
      "event": "trigger: planned swap after drain done (at most about a second)"
    },
    {
      "from": "hub",
      "to": "subscribers",
      "msg": {
        "jsonrpc": "2.0",
        "method": "facts.changed",
        "params": {
          "subscription": 1,
          "key": "module.foxglove.example-art.state",
          "value": "updating"
        }
      }
    },
    {
      "from": "hub",
      "to": "subscribers",
      "msg": {
        "jsonrpc": "2.0",
        "method": "facts.changed",
        "params": {
          "subscription": 1,
          "key": "module.foxglove.example-art.reason",
          "value": "Your place on this page is kept"
        }
      },
      "why": "reason text is plain words and free; only the state id is the contract"
    },
    {
      "expect": {
        "ui_name": "Updating...",
        "ways_out": [],
        "shown_in": [
          "panel header",
          "Modules page",
          "tray status line"
        ]
      }
    }
  ]
}
