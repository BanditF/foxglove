{
  "name": "state-waiting",
  "module": "foxglove.example-art",
  "spec": [
    "7.8"
  ],
  "description": "State waiting: the fact module.<id>.state is 'waiting'.",
  "steps": [
    {
      "event": "trigger: a required module / channel provider is gone"
    },
    {
      "from": "hub",
      "to": "subscribers",
      "msg": {
        "jsonrpc": "2.0",
        "method": "facts.changed",
        "params": {
          "subscription": 1,
          "key": "module.foxglove.example-art.state",
          "value": "waiting"
        }
      }
    },
    {
      "from": "hub",
      "to": "subscribers",
      "msg": {
        "jsonrpc": "2.0",
        "method": "facts.changed",
        "params": {
          "subscription": 1,
          "key": "module.foxglove.example-art.reason",
          "value": "Example Link is not running"
        }
      },
      "why": "reason text is plain words and free; only the state id is the contract"
    },
    {
      "expect": {
        "ui_name": "Waiting for Example Link",
        "ways_out": [
          "Go to Example Link"
        ],
        "shown_in": [
          "panel header",
          "Modules page",
          "tray status line"
        ]
      }
    }
  ]
}
