{
  "name": "drain-busy-not-now",
  "module": "foxglove.example-art",
  "spec": [
    "7.6",
    "7.8"
  ],
  "description": "Drain busy, then the user presses Not now: the old version keeps running, nothing more is sent.",
  "steps": [
    {
      "from": "hub",
      "to": "old-instance",
      "msg": {
        "jsonrpc": "2.0",
        "id": 10,
        "method": "module.drain",
        "params": {
          "reason": "update"
        }
      }
    },
    {
      "from": "old-instance",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 10,
        "result": {
          "state": "busy",
          "reason": "a wizard open"
        }
      }
    },
    {
      "event": "user clicks Not now"
    },
    {
      "expect": {
        "no_message_sent": "module.drain"
      }
    }
  ]
}
