{
  "name": "overlap",
  "module": "foxglove.example-art",
  "spec": [
    "7.6"
  ],
  "description": "Hot swap, swap=overlap: stage, drain (done), start the new beside the old, route new calls on its module.ready, exit the old.",
  "steps": [
    {
      "event": "new version staged in its own folder; launch check passes"
    },
    {
      "from": "hub",
      "to": "old-instance",
      "msg": {
        "jsonrpc": "2.0",
        "id": 10,
        "method": "module.drain",
        "params": {
          "reason": "update"
        }
      }
    },
    {
      "from": "old-instance",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 10,
        "result": {
          "state": "done"
        }
      }
    },
    {
      "event": "old finishes calls in flight (5 s cap) and receives no new ones"
    },
    {
      "event": "hub starts new instance beside old"
    },
    {
      "from": "new-instance",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
          "id": "foxglove.example-art",
          "version": "0.5.0",
          "instance": "inst-2",
          "token": "tok-launch-2",
          "hub": "1.0",
          "api": {
            "foxglove": "1.13"
          }
        }
      }
    },
    {
      "from": "hub",
      "to": "new-instance",
      "msg": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "hub": "1.2",
          "api": {
            "foxglove": "1.13"
          },
          "granted": [
            "facts.read:keyboard.*",
            "hub.notify",
            "provide:example.art.*",
            "channel.offer:previews"
          ],
          "settings_dir": "C:/example/settings/foxglove.example-art",
          "data_dir": "C:/example/data/foxglove.example-art",
          "safe_mode": false
        }
      }
    },
    {
      "from": "new-instance",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "module.register",
        "params": {
          "methods": [
            "example.art.*"
          ],
          "facts": [],
          "channels": [],
          "apis": {
            "foxglove": "1.13"
          }
        }
      }
    },
    {
      "from": "hub",
      "to": "new-instance",
      "msg": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "rejected": []
        }
      }
    },
    {
      "from": "new-instance",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "ui.register",
        "params": {
          "instance": "inst-2",
          "panels": [
            {
              "id": "art",
              "slot": "page",
              "title": "Art",
              "icon": "image",
              "tree": {
                "type": "column",
                "id": "root",
                "props": {},
                "children": [
                  {
                    "type": "label",
                    "id": "title",
                    "props": {
                      "text": "Art"
                    }
                  },
                  {
                    "type": "button",
                    "id": "next",
                    "props": {
                      "label": "Next"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "from": "hub",
      "to": "new-instance",
      "msg": {
        "jsonrpc": "2.0",
        "id": 3,
        "result": {
          "rejected": []
        }
      }
    },
    {
      "from": "new-instance",
      "to": "hub",
      "msg": {
        "jsonrpc": "2.0",
        "method": "module.ready",
        "params": {
          "instance": "inst-2"
        }
      }
    },
    {
      "event": "routing table changes in one step; facts published again"
    },
    {
      "from": "hub",
      "to": "old-instance",
      "msg": {
        "jsonrpc": "2.0",
        "method": "module.exit",
        "params": {
          "reason": "update"
        }
      }
    },
    {
      "event": "old exits 0 within 5 s"
    }
  ]
}
