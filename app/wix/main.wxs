<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- cargo-wix 0.3.8 doesn't define CargoManifestDir: the app folder is the one above this file. -->
  <?ifndef CargoManifestDir?>
  <?define CargoManifestDir = "$(sys.SOURCEFILEDIR).." ?>
  <?endif?>
  <Product Id="*" Name="Foxglove" Language="1033" Version="$(var.Version)"
           Manufacturer="BanditF" UpgradeCode="40F2C6EE-F034-4FE5-91BC-65F1E74F7D24">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64" />
    <!-- AllowSameVersionUpgrades: a rebuilt MSI of the same version replaces the installed one
         instead of installing next to it (the product code changes with every build). Light's
         ICE61 warning about it is expected: Foxglove has one product line, so a same-version
         MSI is always a rebuild of this product. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Foxglove is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="INSTALLLEVEL" Value="1" />
    <Icon Id="FoxgloveIcon" SourceFile="$(var.CargoManifestDir)\resources\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="FoxgloveIcon" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Foxglove">
          <Component Id="Application" Guid="*" Win64="yes">
            <File Id="FoxgloveExe" Source="$(var.CargoTargetBinDir)\foxglove.exe" KeyPath="yes" />
            <File Id="License" Source="$(var.CargoManifestDir)\LICENSE" />
          </Component>
<?ifdef SparseIdentity?>
          <!-- #179 prototype, only with -dSparseIdentity=<signed msix>: the sparse identity
               package next to the exe; Foxglove registers it per user on first launch. -->
          <Component Id="IdentityPackage" Guid="*" Win64="yes">
            <File Id="IdentityMsix" Name="foxglove-identity.msix" Source="$(var.SparseIdentity)" KeyPath="yes" />
          </Component>
<?endif?>
          <Component Id="StartMenu" Guid="*" Win64="yes">
            <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Foxglove"
                      Target="[INSTALLFOLDER]foxglove.exe" WorkingDirectory="INSTALLFOLDER" Icon="FoxgloveIcon" />
            <!-- The Start menu is a per-user folder to the ICE checks (ICE43, ICE57), so the
                 key path is per-user too; the exe is named by path, not by another
                 component's file (ICE69). -->
            <RegistryValue Root="HKCU" Key="Software\Foxglove\Installer" Name="StartMenu"
                           Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
      <Directory Id="AppDataFolder">
        <!-- Per-user opt-in: owned and removed by MSI, never touches app settings. -->
        <Component Id="Autostart" Guid="*" Win64="yes">
          <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run"
                         Name="Foxglove" Type="string" Value="&quot;[INSTALLFOLDER]foxglove.exe&quot;" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>

    <Feature Id="App" Title="Foxglove" Description="The app and Start menu shortcut."
             Level="1" Absent="disallow" Display="expand">
      <ComponentRef Id="Application" />
      <ComponentRef Id="StartMenu" />
<?ifdef SparseIdentity?>
      <ComponentRef Id="IdentityPackage" />
<?endif?>
      <Feature Id="StartWithWindows" Title="Start with Windows"
               Description="Start Foxglove when the installing user signs in." Level="2">
        <ComponentRef Id="Autostart" />
      </Feature>
    </Feature>
<?ifdef SparseIdentity?>
    <!-- Uninstall (not a major upgrade, which keeps the registration): remove the identity
         package for every user. Elevated, so it can reach other users' registrations. -->
    <CustomAction Id="UnregisterIdentity" FileKey="FoxgloveExe" ExeCommand="--unregister-identity"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="UnregisterIdentity" Before="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>
<?endif?>
    <UIRef Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.CargoManifestDir)\wix\license.rtf" />
  </Product>
</Wix>
